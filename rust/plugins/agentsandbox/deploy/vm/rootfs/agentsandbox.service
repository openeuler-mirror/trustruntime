[Unit]
Description=AgentSandbox HiController
After=network.target run-agentsandbox.mount
Requires=run-agentsandbox.mount

[Service]
Type=simple
EnvironmentFile=/etc/agentsandbox/agentsandbox.env
ExecStart=/usr/bin/agentsandbox-controller
StandardOutput=append:/tmp/agentsandbox.log
StandardError=inherit
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
