# AgentSandbox default environment variables
# Shared by agentsandbox.service and proxy.service
# Override by editing this file or setting vars in systemd unit drop-ins.

# ---- HiController (agentsandbox.service) ----
AGENTSANDBOX_CONFIG_DIR=/etc/agentsandbox/configs
AGENTSANDBOX_SOCK_PATH=/run/kata-containers/sandbox/ephemeral/empty-dir/agentsandbox.sock
AGENTSANDBOX_PROXY_SOCK=/run/agentsandbox/proxy.sock
AGENTSANDBOX_LOG_DIR=/tmp/agentsandbox
AGENTSANDBOX_LOG_LEVEL=INFO

# ---- proxy_proc (proxy.service) ----
AGENTSANDBOX_PROXY_LISTEN_ADDR=127.0.0.1
AGENTSANDBOX_PROXY_LISTEN_PORT=8443
AGENTSANDBOX_CA_CERT_PATH=/etc/agentsandbox/ca.crt
AGENTSANDBOX_CA_KEY_PATH=/etc/agentsandbox/ca.key
